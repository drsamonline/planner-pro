{
  "name": "Planner Pro — offline day, week & year planner",
  "short_name": "Planner Pro",
  "description": "A local-first planner for day, week, month and year. Multi-profile with PIN lock. No accounts, no servers, works offline.",
  "id": "planner-pro",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0B1220",
  "theme_color": "#0B1220",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "lifestyle",
    "utilities"
  ],
  "icons": [
    {
      "src": "assets/img/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/img/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Today",
      "short_name": "Today",
      "url": "./index.html#/today",
      "icons": [
        {
          "src": "assets/img/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Quick add",
      "short_name": "Add",
      "url": "./index.html#/day",
      "icons": [
        {
          "src": "assets/img/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Search",
      "short_name": "Search",
      "url": "./index.html#/search",
      "icons": [
        {
          "src": "assets/img/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}