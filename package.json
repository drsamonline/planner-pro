{
  "name": "planner-pro",
  "productName": "Planner Pro",
  "version": "15.0.0",
  "private": true,
  "description": "Offline-first day, week, month and year planner. Multi-profile, PIN locked, no accounts, no servers.",
  "author": {
    "name": "Dr. Sohil Momin",
    "email": "sohilmomin2000@gmail.com",
    "url": "https://github.com/drsamonline"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://drsamonline.github.io/planner-pro/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drsamonline/planner-pro.git"
  },
  "bugs": {
    "url": "https://github.com/drsamonline/planner-pro/issues"
  },
  "keywords": [
    "planner",
    "offline",
    "pwa",
    "productivity",
    "journal",
    "vanilla-js",
    "local-first"
  ],
  "main": "build/electron/main.cjs",
  "scripts": {
    "start": "python3 -m http.server 8080 --directory app",
    "test": "node test/smoke.mjs",
    "shots": "node test/screenshots.mjs",
    "build:single": "node build/make-single-file.mjs",
    "build:web": "node build/make-web-zip.mjs",
    "build": "npm run build:single && npm run build:web",
    "electron": "electron build/electron/main.cjs",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "puppeteer-core": "^24.0.0",
    "esbuild": "^0.28.0"
  },
  "build": {
    "appId": "com.drsamonline.plannerpro",
    "productName": "Planner Pro",
    "directories": {
      "output": "dist/desktop",
      "buildResources": "build/electron"
    },
    "files": [
      "app/**/*",
      "build/electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "app/assets/img/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "app/assets/img/icon-512.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "app/assets/img/icon-512.png"
    }
  }
}
